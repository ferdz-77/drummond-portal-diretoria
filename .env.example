# Arquivo de configuração de ambiente
# Copie este arquivo para .env e ajuste os valores para produção

# Ambiente: development ou production
APP_ENV=development

# NOTA IMPORTANTE:
# As credenciais específicas de produção estão configuradas diretamente no config_env.php
# por questões de segurança. As credenciais fornecidas já foram implementadas:
#
# - Ouvidoria: bdsolicita_atendimento (user: bdsolatend)
# - EAD: dbead (user: eaduseroot)
# - Processo Seletivo: pseldb (user: pseluserdb)
# - Secretaria: dbsecretacad (user: dbsecretacaduser)
# - Financeiro: fini (user: userfinidb)
# - Ex-Aluno: bdsolicita_atendimento (mesmas credenciais da Ouvidoria)
#
# Para o Portal da Diretoria (notificações), será necessário configurar:
# - host, user, pass e dbname específicos quando disponíveis

# Se precisar alterar credenciais, edite o arquivo includes/config_env.php diretamente